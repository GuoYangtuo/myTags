// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  nickname   String   @default("")
  avatarSeed String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // VIP 会员相关
  isVip      Boolean  @default(false)    // 是否为VIP会员
  vipExpireAt DateTime?                  // VIP过期时间，为null表示永久或未开通

  pages     Page[]
  shares    Share[]
  favorites Favorite[]
  subscriptions Subscription[]
}

model Page {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 页面内容直接存储为 JSON，包含所有分类和标签
  content     String   @db.LongText

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares     Share[]
}

model Share {
  id          Int       @id @default(autoincrement())
  userId      Int
  pageId      Int
  shareCode   String    @unique
  expiresAt   DateTime?
  visibleItems String?  @db.LongText  // JSON array of category/tag IDs, null = all visible
  rootCategoryId Int?                          // If set, share shows only this category's sub-tree
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  shareCode String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shareCode])
}

// VIP 订阅订单
model Subscription {
  id          Int      @id @default(autoincrement())
  userId      Int
  orderNo     String   @unique           // 本地订单号（我这里叫out_trade_no）
  tradeNo     String?  @unique           // 支付平台订单号（回调通知返回）
  money       Decimal  @db.Decimal(10,2) // 充值金额（元），固定 6.90
  status      String   @default("pending") // pending | paid | cancelled | refunded
  payType     String?                      // alipay | wxpay
  expiredAt   DateTime?                   // 本次订阅到期时间（按月计）
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
